# Copy to server/.env. Never commit the real file or paste the key into chat.
AI_PROVIDER=zhipu
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_MODEL=glm-5.2
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_JSON_MODE=true

# Optional: switch back to OpenAI by setting AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
PORT=8787
HOST=127.0.0.1
# For production, replace * with the exact HTTPS app origin.
ALLOWED_ORIGIN=http://127.0.0.1:4173
